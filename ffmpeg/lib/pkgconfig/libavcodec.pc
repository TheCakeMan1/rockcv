prefix=../
exec_prefix=${prefix}
libdir=../../lib
includedir=../../include

Name: libavcodec
Description: FFmpeg codec library
Version: 60.31.102
Requires: 
Requires.private: libswresample >= 4.12.100, libavutil >= 58.29.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm -latomic -lrga -llzma -lx264 -lx265 -lrockchip_mpp -L/usr/local/lib -lz
Cflags: -I${includedir}
