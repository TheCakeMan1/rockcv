#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D srcImg;         // выборка point
layout(binding = 1, r8) writeonly uniform image2D dstImg;

layout(push_constant) uniform PC {
    int   radius;
    float invW;
    float invH;
    vec2  dir;              // (1,0) — горизонт; (0,1) — вертикаль
    float weights[32];      // до радиуса 31
} pc;

void main() {
    ivec2 p  = ivec2(gl_GlobalInvocationID.xy);
    vec2  uv = (vec2(p) + vec2(0.5)) * vec2(pc.invW, pc.invH);

    float acc = texture(srcImg, uv).r * pc.weights[0];
    for (int i = 1; i <= pc.radius; ++i) {
        vec2 du = pc.dir * vec2(float(i) * pc.invW, float(i) * pc.invH);
        acc += texture(srcImg, uv + du).r * pc.weights[i];
        acc += texture(srcImg, uv - du).r * pc.weights[i];
    }
    imageStore(dstImg, p, vec4(acc, 0.0, 0.0, 1.0));
}
