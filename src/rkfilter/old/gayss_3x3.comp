#version 450

// Локальная сетка 16×16
layout (local_size_x = 16, local_size_y = 16) in;

// Plane 0 (Y) — R8 storage image
layout (binding = 0, r8) readonly  uniform image2D inY;
layout (binding = 1, r8) writeonly uniform image2D outY;

// Plane 1 (UV) — RG8 storage image
layout (binding = 2, rg8) readonly  uniform image2D inUV;
layout (binding = 3, rg8) writeonly uniform image2D outUV;

// Включи размытие и для UV (по умолчанию — passthrough)
#define BLUR_UV 0

const float K[3][3] = float[3][3](
    float[3](1.0/16.0, 2.0/16.0, 1.0/16.0),
    float[3](2.0/16.0, 4.0/16.0, 2.0/16.0),
    float[3](1.0/16.0, 2.0/16.0, 1.0/16.0)
);

ivec2 clampCoord(ivec2 c, ivec2 sz) {
    c.x = clamp(c.x, 0, sz.x - 1);
    c.y = clamp(c.y, 0, sz.y - 1);
    return c;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);

    // --- Y plane ---
    ivec2 ySize = imageSize(inY);
    if (gid.x < ySize.x && gid.y < ySize.y) {
        float s = 0.0;
        for (int ky=-1; ky<=1; ++ky)
        for (int kx=-1; kx<=1; ++kx) {
            ivec2 cc = clampCoord(gid + ivec2(kx,ky), ySize);
            float y = imageLoad(inY, cc).r;
            s += y * K[ky+1][kx+1];
        }
        imageStore(outY, gid, vec4(s, 0, 0, 1));
    }

    // --- UV plane (w/2 × h/2) ---
    ivec2 uvSize = imageSize(inUV);
    if (gid.x < uvSize.x && gid.y < uvSize.y) {
    #if BLUR_UV
        vec2 sUV = vec2(0.0);
        for (int ky=-1; ky<=1; ++ky)
        for (int kx=-1; kx<=1; ++kx) {
            ivec2 cc = clampCoord(gid + ivec2(kx,ky), uvSize);
            vec2 uv = imageLoad(inUV, cc).rg;
            sUV += uv * K[ky+1][kx+1];
        }
        imageStore(outUV, gid, vec4(sUV, 0, 1));
    #else
        vec2 uv = imageLoad(inUV, gid).rg;
        imageStore(outUV, gid, vec4(uv, 0, 1));
    #endif
    }
}